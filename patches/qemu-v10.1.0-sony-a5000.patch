+/*
+ * Cortex-A5 MPCore (Sony CXD90014 / BIONZ X, a5000).
+ * Modelled on the A9 definition with A5 identification and cache geometry
+ * (32KB 4-way L1 I/D, 32-byte lines).  The CXD90014 implements VFPv4-D16
+ * without NEON: the Sony vfp_init BUG()s with "VFP is not D16 type"
+ * otherwise.
+ */
+static void cortex_a5_initfn(Object *obj)
+{
+    ARMCPU *cpu = ARM_CPU(obj);
+    ARMISARegisters *isar = &cpu->isar;
+
+    cpu->dtb_compatible = "arm,cortex-a5";
+    set_feature(&cpu->env, ARM_FEATURE_V7);
+    set_feature(&cpu->env, ARM_FEATURE_THUMB2EE);
+    set_feature(&cpu->env, ARM_FEATURE_EL3);
+    set_feature(&cpu->env, ARM_FEATURE_PMU);
+    set_feature(&cpu->env, ARM_FEATURE_V7MP);
+    set_feature(&cpu->env, ARM_FEATURE_CBAR);
+    cpu->midr = 0x410fc051;          /* Cortex-A5 r0p1 */
+    cpu->reset_fpsid = 0x41023051;
+    cpu->isar.mvfr0 = 0x10110221;   /* VFPv4, 16 D-regs */
+    cpu->isar.mvfr1 = 0x01000011;   /* FPHP, no Advanced SIMD */
+    cpu->ctr = 0x80038003;
+    cpu->reset_sctlr = 0x00c50078;
+    SET_IDREG(isar, ID_PFR0, 0x1031);
+    SET_IDREG(isar, ID_PFR1, 0x11);
+    SET_IDREG(isar, ID_DFR0, 0x000);
+    SET_IDREG(isar, ID_AFR0, 0);
+    SET_IDREG(isar, ID_MMFR0, 0x00100103);
+    SET_IDREG(isar, ID_MMFR1, 0x40000000);
+    SET_IDREG(isar, ID_MMFR2, 0x01230000);
+    SET_IDREG(isar, ID_MMFR3, 0x00102111);
+    SET_IDREG(isar, ID_ISAR0, 0x00101111);
+    SET_IDREG(isar, ID_ISAR1, 0x13112111);
+    SET_IDREG(isar, ID_ISAR2, 0x21232041);
+    SET_IDREG(isar, ID_ISAR3, 0x11112131);
+    SET_IDREG(isar, ID_ISAR4, 0x00011142);
+    cpu->isar.dbgdidr = 0x1203f001;
+    SET_IDREG(isar, CLIDR, (1 << 27) | (1 << 24) | 3);
+    cpu->ccsidr[0] = 0xe01fe019; /* 32k L1 dcache. */
+    cpu->ccsidr[1] = 0x201fe019; /* 32k L1 icache. */
+    cpu->isar.reset_pmcr_el0 = 0x41051000;
+    define_arm_cp_regs(cpu, cortexa9_cp_reginfo);
+}
