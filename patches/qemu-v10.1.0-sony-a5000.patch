diff --git a/hw/block/cxd90014_nand.c b/hw/block/cxd90014_nand.c
new file mode 100644
index 0000000..e6c47cb
--- /dev/null
+++ b/hw/block/cxd90014_nand.c
@@ -0,0 +1,125 @@
+/*
+ * Sony CXD90014 NAND subsystem (a5000): NAND controller register block
+ * (UDIF "nand_reg", PA 0x00020000), NAND data window ("nandc",
+ * PA 0x10000000) and the ARM7 sub-CPU I/O block ("arm7io", PA 0x00011000).
+ *
+ * Register values the bootloader leaves behind were recovered from lld.ko's
+ * cached copy in the real camera's WBI RAM snapshot:
+ *   0x140 = 0       chips - 1
+ *   0x150 = 0x40    pages per block
+ *   0x170 = 0x1000  user blocks
+ *   0x180 = 0x100   extra blocks
+ *
+ * This file starts as a register file with full access logging; behaviour
+ * is filled in as lld.ko's protocol is reverse engineered (see
+ * emulator/docs/NAND.md).
+ */
+
+#include "qemu/osdep.h"
+#include "hw/sysbus.h"
+#include "hw/irq.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "qom/object.h"
+
+#define TYPE_CXD_NAND "cxd90014-nand"
+OBJECT_DECLARE_SIMPLE_TYPE(CXDNandState, CXD_NAND)
+
+struct CXDNandState {
+    SysBusDevice parent_obj;
+    MemoryRegion reg_mr;     /* 0x00020000, 64 KiB */
+    MemoryRegion arm7io_mr;  /* 0x00011000, 4 KiB */
+    uint32_t reg[0x10000 / 4];
+    uint32_t arm7io[0x1000 / 4];
+    qemu_irq nand_irq;
+    qemu_irq arm7_irq;
+};
+
+static uint64_t nreg_read(void *opaque, hwaddr off, unsigned size)
+{
+    CXDNandState *s = opaque;
+    uint32_t v = s->reg[off / 4];
+    qemu_log_mask(LOG_UNIMP, "nand-reg: rd 0x%04" HWADDR_PRIx " -> 0x%08x\n",
+                  off, v);
+    return v;
+}
+
+static void nreg_write(void *opaque, hwaddr off, uint64_t v, unsigned size)
+{
+    CXDNandState *s = opaque;
+    qemu_log_mask(LOG_UNIMP, "nand-reg: wr 0x%04" HWADDR_PRIx " = 0x%08"
+                  PRIx64 "\n", off, v);
+    s->reg[off / 4] = v;
+}
+
+static uint64_t a7_read(void *opaque, hwaddr off, unsigned size)
+{
+    CXDNandState *s = opaque;
+    uint32_t v = s->arm7io[off / 4];
+    qemu_log_mask(LOG_UNIMP, "arm7io: rd 0x%03" HWADDR_PRIx " -> 0x%08x\n",
+                  off, v);
+    return v;
+}
+
+static void a7_write(void *opaque, hwaddr off, uint64_t v, unsigned size)
+{
+    CXDNandState *s = opaque;
+    qemu_log_mask(LOG_UNIMP, "arm7io: wr 0x%03" HWADDR_PRIx " = 0x%08"
+                  PRIx64 "\n", off, v);
+    s->arm7io[off / 4] = v;
+}
+
+static const MemoryRegionOps nreg_ops = {
+    .read = nreg_read, .write = nreg_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+static const MemoryRegionOps a7_ops = {
+    .read = a7_read, .write = a7_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+static void nand_reset(DeviceState *dev)
+{
+    CXDNandState *s = CXD_NAND(dev);
+    memset(s->reg, 0, sizeof(s->reg));
+    memset(s->arm7io, 0, sizeof(s->arm7io));
+    s->reg[0x140 / 4] = 0;
+    s->reg[0x150 / 4] = 0x40;
+    s->reg[0x170 / 4] = 0x1000;
+    s->reg[0x180 / 4] = 0x100;
+}
+
+static void nand_init(Object *obj)
+{
+    CXDNandState *s = CXD_NAND(obj);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(obj);
+    memory_region_init_io(&s->reg_mr, obj, &nreg_ops, s, "nand-reg", 0x10000);
+    memory_region_init_io(&s->arm7io_mr, obj, &a7_ops, s, "arm7io", 0x1000);
+    sysbus_init_mmio(sbd, &s->reg_mr);
+    sysbus_init_mmio(sbd, &s->arm7io_mr);
+    sysbus_init_irq(sbd, &s->nand_irq);
+    sysbus_init_irq(sbd, &s->arm7_irq);
+}
+
+static void nand_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    device_class_set_legacy_reset(dc, nand_reset);
+}
+
+static const TypeInfo nand_info = {
+    .name = TYPE_CXD_NAND,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(CXDNandState),
+    .instance_init = nand_init,
+    .class_init = nand_class_init,
+};
+
+static void nand_register(void)
+{
+    type_register_static(&nand_info);
+}
+type_init(nand_register)
