+
+/*
+ * Cortex-A5 MPCore (Sony CXD90014 / BIONZ X, a5000).
+ * Modelled on the A9 definition with A5 identification and cache geometry
+ * (32KB 4-way L1 I/D, 32-byte lines).  The CXD90014 implements VFPv4-D16
+ * without NEON: the Sony vfp_init BUG()s with "VFP is not D16 type"
+ * otherwise.
+ */
+static void cortex_a5_initfn(Object *obj)
+{
+    ARMCPU *cpu = ARM_CPU(obj);
+    ARMISARegisters *isar = &cpu->isar;
+
