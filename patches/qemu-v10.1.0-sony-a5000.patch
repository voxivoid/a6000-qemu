diff --git a/hw/dma/cxd90014_dmac.c b/hw/dma/cxd90014_dmac.c
new file mode 100644
index 0000000..dd9d1ee
--- /dev/null
+++ b/hw/dma/cxd90014_dmac.c
@@ -0,0 +1,156 @@
+/*
+ * Sony CXD90014 "BOSS" memory-to-memory DMA controller (a5000).
+ *
+ * Two units (UDIF dmac_ch0-3 @ PA 0xF0000000, dmac_ch4-7 @ 0xF0010000),
+ * four channels each, GIC IRQ 189 + ch.  Layout from dmac.ko
+ * (boss_lld_get_base_addr_dmac_ch, boss_hw_dmac_start_wait/_transfer,
+ * boss_hw_dmac_process, boss_hw_dmac_unit_enable):
+ *
+ *   unit +0x00               unit enable (0x11000000 on / 0x10000000 off)
+ *   ch   +0x10 + 0x30*(ch%4)
+ *     +0x00..+0x14  first descriptor: {len-1, src, dst, cfg, cfg, next|1}
+ *     +0x18         start/config (dmac.ko writes 0x11102003) -> go
+ *     +0x1C         control (dmac.ko writes 17 before start)
+ *     +0x20         status: low nibble 8 = done OK; written 0 to ack
+ *
+ * In-memory descriptors (32 B, built by nand.ko muminlzp_request):
+ *   {len-1 (0xFFFFFFFF = empty), src phys, dst phys, cfg, cfg,
+ *    next phys | 1 (bit0 = another descriptor follows), -, -}
+ * cfg (0x30F00) is treated as plain incrementing byte copy [hypothesis].
+ * Transfers complete instantly.
+ */
+
+#include "qemu/osdep.h"
+#include "hw/sysbus.h"
+#include "hw/irq.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "qom/object.h"
+#include "system/address-spaces.h"
+#include "trace.h"
+
+#define TYPE_CXD_DMAC "cxd90014-dmac"
+OBJECT_DECLARE_SIMPLE_TYPE(CXDDmacState, CXD_DMAC)
+
+#define NCH 4
+
+struct CXDDmacState {
+    SysBusDevice parent_obj;
+    MemoryRegion mr;
+    uint32_t enable;
+    uint32_t ch[NCH][12];
+    qemu_irq irq[NCH];
+};
+
+static uint32_t g32(hwaddr pa)
+{
+    return address_space_ldl_le(&address_space_memory, pa,
+                                MEMTXATTRS_UNSPECIFIED, NULL);
+}
+
+static void copy_one(uint32_t lenm1, uint32_t src, uint32_t dst)
+{
+    if (lenm1 == 0xFFFFFFFF) {
+        return;
+    }
+    uint32_t len = lenm1 + 1;
+    g_autofree uint8_t *buf = g_malloc(len);
+    address_space_read(&address_space_memory, src, MEMTXATTRS_UNSPECIFIED,
+                       buf, len);
+    address_space_write(&address_space_memory, dst, MEMTXATTRS_UNSPECIFIED,
+                        buf, len);
+}
+
+static void run_chain(CXDDmacState *s, int c)
+{
+    uint32_t *r = s->ch[c];
+    uint32_t n = 0;
+    copy_one(r[0], r[1], r[2]);
+    uint32_t next = r[5];
+    while ((next & 1) && n++ < 65536) {
+        hwaddr d = next & ~1u;
+        copy_one(g32(d), g32(d + 4), g32(d + 8));
+        next = g32(d + 20);
+    }
+    trace_cxd_dmac_done(c, n + 1);
+    r[8] = 8;                       /* status: done OK */
+    qemu_set_irq(s->irq[c], 1);
+}
+
+static uint64_t dmac_read(void *opaque, hwaddr off, unsigned size)
+{
+    CXDDmacState *s = opaque;
+    if (off == 0) {
+        return s->enable;
+    }
+    if (off >= 0x10 && off < 0x10 + 0x30 * NCH) {
+        hwaddr o = off - 0x10;
+        return s->ch[o / 0x30][(o % 0x30) / 4];
+    }
+    qemu_log_mask(LOG_UNIMP, "cxd-dmac: rd 0x%" HWADDR_PRIx "\n", off);
+    return 0;
+}
+
+static void dmac_write(void *opaque, hwaddr off, uint64_t v, unsigned size)
+{
+    CXDDmacState *s = opaque;
+    if (off == 0) {
+        s->enable = v;
+        return;
+    }
+    if (off >= 0x10 && off < 0x10 + 0x30 * NCH) {
+        hwaddr o = off - 0x10;
+        int c = o / 0x30, reg = (o % 0x30) / 4;
+        s->ch[c][reg] = v;
+        if (reg == 6 && v) {        /* start */
+            run_chain(s, c);
+        } else if (reg == 8 && v == 0) {
+            qemu_set_irq(s->irq[c], 0);
+        }
+        return;
+    }
+    qemu_log_mask(LOG_UNIMP, "cxd-dmac: wr 0x%" HWADDR_PRIx " = 0x%"
+                  PRIx64 "\n", off, v);
+}
+
+static const MemoryRegionOps dmac_ops = {
+    .read = dmac_read, .write = dmac_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+static void dmac_reset(DeviceState *dev)
+{
+    CXDDmacState *s = CXD_DMAC(dev);
+    s->enable = 0;
+    memset(s->ch, 0, sizeof(s->ch));
+}
+
+static void dmac_init(Object *obj)
+{
+    CXDDmacState *s = CXD_DMAC(obj);
+    memory_region_init_io(&s->mr, obj, &dmac_ops, s, "cxd-dmac", 0x10000);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->mr);
+    for (int i = 0; i < NCH; i++) {
+        sysbus_init_irq(SYS_BUS_DEVICE(obj), &s->irq[i]);
+    }
+}
+
+static void dmac_class_init(ObjectClass *klass, const void *data)
+{
+    device_class_set_legacy_reset(DEVICE_CLASS(klass), dmac_reset);
+}
+
+static const TypeInfo dmac_info = {
+    .name = TYPE_CXD_DMAC,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(CXDDmacState),
+    .instance_init = dmac_init,
+    .class_init = dmac_class_init,
+};
+
+static void dmac_register(void)
+{
+    type_register_static(&dmac_info);
+}
+type_init(dmac_register)
diff --git a/hw/dma/cxd90014_mdma.c b/hw/dma/cxd90014_mdma.c
new file mode 100644
index 0000000..36da443
--- /dev/null
+++ b/hw/dma/cxd90014_mdma.c
@@ -0,0 +1,126 @@
+/*
+ * CXD90014 16-channel memory DMA used by av-cam.bin (a5000).
+ * Units at PA 0xF0102000 (ch0-7) and 0xF0103000 (ch8-15), GIC 173 + ch.
+ * Recovered from av-cam: entry_pre copies its initialised data section
+ * with it (ch6 regs +0x1C0..+0x1D0, 25 x 16 KiB), ISR 0x439172b0,
+ * status 0x43917994, stop 0x43917bb0 (docs/RE_AVCAM_IRQ_BOOT.md):
+ *   unit +0x00  per-channel done/IRQ status (bit ch)     +0x08 W clear
+ *        +0x0C  per-channel error status                 +0x10 W clear
+ *        +0x1C  busy bits (always 0: transfers finish at once)
+ *   ch k +0x100 + 0x20*k: +0x00 src PA, +0x04 dst PA, +0x0C cfg (bits
+ *        [11:0] = 32-bit word count, 0 = 4096), +0x10 ctl bit0 = start
+ * Without this model the engine ran with an all-zero .data section.
+ */
+#include "qemu/osdep.h"
+#include "hw/sysbus.h"
+#include "hw/irq.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "qom/object.h"
+#include "system/address-spaces.h"
+#include "trace.h"
+
+#define TYPE_CXD_MDMA "cxd90014-mdma"
+OBJECT_DECLARE_SIMPLE_TYPE(MdmaState, CXD_MDMA)
+
+struct MdmaState {
+    SysBusDevice parent_obj;
+    MemoryRegion mr;
+    uint32_t reg[0x1000 / 4];
+    uint32_t status, err;
+    qemu_irq irq[8];
+};
+
+static void mdma_update(MdmaState *s)
+{
+    for (int k = 0; k < 8; k++) {
+        qemu_set_irq(s->irq[k], (s->status >> k) & 1);
+    }
+}
+
+static void mdma_run(MdmaState *s, int k)
+{
+    uint32_t *c = &s->reg[(0x100 + 0x20 * k) / 4];
+    uint32_t words = c[3] & 0xfff;
+    size_t len = (size_t)(words ? words : 4096) * 4;
+    g_autofree uint8_t *buf = g_malloc(len);
+    address_space_read(&address_space_memory, c[0], MEMTXATTRS_UNSPECIFIED,
+                       buf, len);
+    address_space_write(&address_space_memory, c[1], MEMTXATTRS_UNSPECIFIED,
+                        buf, len);
+    trace_cxd_mdma_copy(k, c[0], c[1], len);
+    c[4] &= ~1u;
+    s->status |= 1u << k;
+    mdma_update(s);
+}
+
+static uint64_t mdma_read(void *opaque, hwaddr off, unsigned size)
+{
+    MdmaState *s = opaque;
+    switch (off) {
+    case 0x00: return s->status;
+    case 0x0C: return s->err;
+    case 0x1C: return 0;
+    }
+    return s->reg[off / 4];
+}
+
+static void mdma_write(void *opaque, hwaddr off, uint64_t v, unsigned size)
+{
+    MdmaState *s = opaque;
+    switch (off) {
+    case 0x08:
+        s->status &= ~v;
+        mdma_update(s);
+        return;
+    case 0x10:
+        s->err &= ~v;
+        return;
+    }
+    s->reg[off / 4] = v;
+    if (off >= 0x100 && off < 0x200 && (off & 0x1f) == 0x10 && (v & 1)) {
+        mdma_run(s, (off - 0x100) / 0x20);
+    }
+}
+
+static const MemoryRegionOps mdma_ops = {
+    .read = mdma_read, .write = mdma_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+static void mdma_reset(DeviceState *dev)
+{
+    MdmaState *s = CXD_MDMA(dev);
+    memset(s->reg, 0, sizeof(s->reg));
+    s->status = s->err = 0;
+}
+
+static void mdma_init(Object *obj)
+{
+    MdmaState *s = CXD_MDMA(obj);
+    memory_region_init_io(&s->mr, obj, &mdma_ops, s, "cxd-mdma", 0x1000);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->mr);
+    for (int i = 0; i < 8; i++) {
+        sysbus_init_irq(SYS_BUS_DEVICE(obj), &s->irq[i]);
+    }
+}
+
+static void mdma_class_init(ObjectClass *klass, const void *data)
+{
+    device_class_set_legacy_reset(DEVICE_CLASS(klass), mdma_reset);
+}
+
+static const TypeInfo mdma_info = {
+    .name = TYPE_CXD_MDMA,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(MdmaState),
+    .instance_init = mdma_init,
+    .class_init = mdma_class_init,
+};
+
+static void mdma_register(void)
+{
+    type_register_static(&mdma_info);
+}
+type_init(mdma_register)
